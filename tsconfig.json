{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["audioworklet", "vitest/globals"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": ["src/engine/**/*.ts", "src/coordinator/**/*.ts", "src/sw/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/engine/__tests__/fixtures/**/src/**",
    "src/builtin-plugins/**/src/**"
  ]
}
